# scheme for xcodebuild
# name found by running: `xcrun xcodebuild -list` (or, see output of workflow run)
scheme("CioFirebaseWrapper")

# -destination for xcodebuild
# Device and OS are both pinned: when a destination does not resolve, fastlane logs
# "couldn't find matching simulator" and quietly falls back to another one, making the tested
# OS an accident of the runner image. That is exactly how this repo ended up testing on iOS
# 18.5 for months. The xcode-27 image ships only the iOS 27.0 runtime, alongside the Xcode 27.0
# that .github/workflows/test.yml selects. An older Xcode cannot drive a newer runtime, so this
# depends on that xcode-version pin. Change one, check the other.
devices([
  "iPhone 17 (27.0)"
])
# Fail instead of falling back when the destination above does not resolve.
ensure_devices_found(true)

output_types("html,junit")
output_files("test-report.html,test-report.xml")
output_directory(".")

code_coverage(true)
result_bundle(true) # required to get code coverage report 
derived_data_path(".build/derivedData")

skip_build(true) # speed up testing 

package_path("./")

